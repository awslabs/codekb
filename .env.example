# ─── CodeKB Docker Environment Variables ───
# Copy this to .env and fill in your values:  cp .env.example .env

CODEKB_AWS_ACCOUNT_ID=<YOUR_ACCOUNT_ID>

# Storage backend
CODEKB_STORAGE_BACKEND=s3_vectors

# S3 bucket for knowledge base data
CODEKB_S3_BUCKET=codekb-knowledgebase-<YOUR_ACCOUNT_ID>
CODEKB_S3_REGION=<YOUR_REGION>

# S3 socket read timeout in seconds (default 300).
# CODEKB_S3_READ_TIMEOUT=300

# S3 Vectors configuration
CODEKB_S3_VECTORS_BUCKET=codekb-vectors-<YOUR_ACCOUNT_ID>
CODEKB_S3_VECTORS_INDEX=codekb-index
CODEKB_S3_VECTORS_REGION=<YOUR_REGION>
# Default number of results for semantic search when `limit` is omitted (integer, default 20)
# CODEKB_S3_VECTORS_DEFAULT_TOP_K=20

# Logging. DEBUG adds request/response payload dumps, capped by
# CODEKB_LOG_PAYLOAD_MAX. Use it briefly and restrict log access.
CODEKB_LOG_LEVEL=WARNING

# Level for the AWS SDK, HTTP client and Strands loggers (default WARNING).
# DEBUG logs every AWS request and response.
# CODEKB_THIRD_PARTY_LOG_LEVEL=WARNING

# Maximum characters logged per payload at DEBUG (default 4000). 0 uncaps these
# dumps, which can include Bedrock prompts and analyzed source code.
# CODEKB_LOG_PAYLOAD_MAX=4000

# ─── OpenTelemetry log export ───
# CodeKB emits structured OpenTelemetry logs. The exporter is mandatory — CodeKB
# refuses to start unless OTEL_LOGS_EXPORTER is set. The DEFAULT below is "none",
# which writes readable log lines to stdout (view with `docker logs codekb`) —
# no OTLP endpoint, credentials, or IAM needed. See "Logs" in docs/configuration.md.
#
# Prefer shipping logs to Amazon CloudWatch instead? Change OTEL_LOGS_EXPORTER
# below to "otlp" and uncomment the block that follows it, signed with SigV4
# using the AWS credentials below. Set <YOUR_REGION> to the SAME region as
# CODEKB_S3_REGION above — that is where setup_aws.sh creates the log
# group, and CodeKB refuses to start if it cannot write there.
OTEL_LOGS_EXPORTER=none
OTEL_SERVICE_NAME=codekb

# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://logs.<YOUR_REGION>.amazonaws.com/v1/logs
# OTEL_EXPORTER_OTLP_HEADERS=x-aws-log-group=/codekb/otel,x-aws-log-stream=codekb
#
# x-aws-log-stream above is a PREFIX. CodeKB creates streams itself as
# "<prefix>/<date>/<container-id>", one per container, rolling over every N
# minutes below (0 disables). Retention is set on the log group, not here.
# OTEL_CLOUDWATCH_LOG_STREAM_ROTATION_MINUTES=1440

# ─── Authentication ───
# Secure by default: this ships as "true" so a fresh copy fails closed.
#
# When "true", protected /api routes and the MCP endpoint require a JWT
# signed by CODEKB_COGNITO_USER_POOL_ID. If authentication cannot initialize,
# those routes return 503 rather than becoming public. /api/health, OAuth
# discovery/callbacks, static assets, SPA routes and OPTIONS stay public by
# design. This is the only mode in which caller identity is trustworthy.
#
# Setting this to "false" disables verification. CodeKB takes identity from an
# unsigned bearer token, an unverified X-User-Identity header, or a shared
# "local-dev" identity when neither is present. Anyone who can reach the service
# can therefore act as another user and use or replace their stored Git token.
# ONLY use "false" for local development on a loopback-only listener you fully
# control. Never expose that mode through a proxy or shared network.
#
# CODEKB_REQUIRE_AUTHENTICATION is the canonical name. CODEKB_REQUIRE_AUTH is an
# accepted backward-compatible alias for the exact same setting; set only one.
CODEKB_REQUIRE_AUTHENTICATION=true

# Cognito user pool that signs the JWTs. USER_POOL_ID and APP_CLIENT_IDS are
# both required while authentication is on; without either, protected /api
# routes and the MCP endpoint return 503. APP_CLIENT_IDS is comma-separated.
# CODEKB_COGNITO_USER_POOL_ID=<YOUR_REGION>_<POOL_ID>
# CODEKB_COGNITO_APP_CLIENT_IDS=<WEB_CLIENT_ID>,<MCP_CLIENT_ID>

# Optional. REGION defaults to CODEKB_S3_REGION. DOMAIN_URL and MCP_CLIENT_ID
# enable OAuth sign-in for MCP clients.
# CODEKB_COGNITO_REGION=<YOUR_REGION>
# CODEKB_COGNITO_DOMAIN_URL=https://<prefix>.auth.<YOUR_REGION>.amazoncognito.com
# CODEKB_COGNITO_MCP_CLIENT_ID=<MCP_CLIENT_ID>

# Optional. Name of a federated identity provider in the user pool. MCP sign-in
# then goes straight to that provider instead of the Cognito provider picker.
# For the same behavior in the web UI, build the image with the same value:
#   docker build --build-arg VITE_COGNITO_IDP_NAME=<IDP_NAME> ...
# CODEKB_COGNITO_IDP_NAME=<IDP_NAME>

# Hostname that MCP clients use to reach CodeKB, without a scheme. Required
# with MCP OAuth unless clients connect through localhost; without it, the
# OAuth metadata points clients to https://localhost. CodeKB always builds
# https:// URLs from this value, so serve the hostname over HTTPS.
# CODEKB_PUBLIC_DOMAIN=codekb.example.com

# Only if MCP clients reach CodeKB under more than one hostname: leave
# CODEKB_PUBLIC_DOMAIN unset and list those hostnames here, separated by commas
# or spaces. CodeKB then builds the OAuth URLs from the request's Host header
# when it matches one of them. Ignored when CODEKB_PUBLIC_DOMAIN is set.
# CODEKB_TRUSTED_HOSTS=codekb.example.com,codekb.internal.example.com

# ─── Path prefix ───
# Only if a reverse proxy serves CodeKB under a path prefix, for example
# https://tools.example.com/codekb/. CodeKB strips this prefix from incoming
# requests. Build the image with the same prefix so the UI requests it too:
#   docker build --build-arg VITE_BASE=/codekb/ ...
# CODEKB_ROOT_PATH=/codekb

# ─── Bedrock model ───
# See model selection and limits in docs/configuration.md.
CODEKB_BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1
CODEKB_BEDROCK_REGION=<YOUR_REGION>
CODEKB_BEDROCK_MAX_TOKENS=65000
CODEKB_BEDROCK_READ_TIMEOUT=3600

# ─── Thinking, effort and per-workload models ───
# Claude 5.x models think by default when no thinking setting is sent, and
# thinking is billed as output tokens. The values in the variables below are sent
# to the model unchanged; unset keeps each model's default (no thinking on Claude
# Opus 4.6 and earlier).
# Example: no up-front thinking on Claude Sonnet 5.5.
# CODEKB_LLM_THINKING=between_tools
# CODEKB_LLM_EFFORT=medium
#
# Each workload can override the shared model, max tokens, thinking and effort:
# CODEKB_<WORKLOAD>_MODEL_ID, _MAX_TOKENS, _THINKING and _EFFORT, where
# <WORKLOAD> is SUMMARIZATION, BUSINESS_CONTEXT, OVERVIEW or CHAT. A workload that sets its
# own model doesn't inherit the shared thinking and effort. Example: keep the chat on Opus 4.6.
# CODEKB_CHAT_MODEL_ID=us.anthropic.claude-opus-4-6-v1
#
# At startup CodeKB sends one short request per distinct model and settings
# combination, and refuses to start if Bedrock rejects the settings. Set to
# false to skip it.
# CODEKB_LLM_STARTUP_CHECK=true

# ─── Secret/PII guardrail ───
# Masks committed secrets/PII on every text-generation call. Created in
# CODEKB_BEDROCK_REGION by setup_aws.sh or the CDK deploy; paste the printed ARN
# below to turn redaction on (a cross-Region model profile still works).
# Enforcement is at the IAM layer: deny model generation that lacks the
# guardrail, so an unset ARN fails closed.
# CODEKB_BEDROCK_GUARDRAIL_ID=<YOUR_GUARDRAIL_ARN>
# CODEKB_BEDROCK_GUARDRAIL_VERSION=DRAFT
# On by default — an IAM deny that blocks any LLM invocation lacking the guardrail.
# To disable (not recommended — secrets/PII then reach Bedrock and the shared
# vector index), set CODEKB_BEDROCK_GUARDRAIL_ENABLED to false. If you use our
# infra, redeploy with the updated env: the CDK deploy and setup_aws.sh skip the
# guardrail and omit the deny.
CODEKB_BEDROCK_GUARDRAIL_ENABLED=true

# ─── Security response headers ───
# The app emits X-Content-Type-Options, X-Frame-Options, and a Content-Security-
# Policy on its own, so they apply behind whatever infra you front it with.
# Sensible defaults ship in the image; override here only if needed.
#
# Security headers are ON by default. Uncomment and set to "false" only to
# disable them (e.g. a fronting proxy owns them).
# CODEKB_SECURITY_HEADERS_ENABLED=false

# Set to "true" to send Content-Security-Policy-Report-Only (observe, don't enforce)
# if the UI misbehaves — collect violations, then switch back to enforcing.
# CODEKB_SECURITY_CSP_REPORT_ONLY=false

# Strict-Transport-Security. Empty by default (HSTS only works over HTTPS and
# includeSubDomains affects sibling hosts). For an HTTPS-only dedicated host:
# CODEKB_SECURITY_HSTS=max-age=31536000; includeSubDomains

# Override the full policy string only if you know you need to:
# CODEKB_SECURITY_CSP=default-src 'self'; ...

# ─── Git hosts ───
# Git host allowlist — host names (not full URLs) permitted for Git clone URLs,
# separated by commas or spaces. Subdomains match automatically (e.g. allowing
# "example.com" also permits "git.example.com").
#
# IMPORTANT: If unset or empty, ALL Git URL analysis is disabled (fail-closed).
# Only zip upload will work. Set this before running CodeKB if you plan to
# analyze repositories by Git URL.
#
# Example: CODEKB_ALLOWED_GIT_HOSTS=github.com, gitlab.com
CODEKB_ALLOWED_GIT_HOSTS=github.com

# Allow a Git host to resolve to a private or loopback address (default false).
# CodeKB resolves the host after the allowlist passes and refuses to clone if it
# lands on a private or loopback IP — an SSRF guard the name-only allowlist can't
# provide. Turn on ONLY for a self-hosted Git server on a private network reached
# by hostname (a private IP literal on CODEKB_ALLOWED_GIT_HOSTS always works).
# Link-local/metadata, multicast and reserved addresses are rejected regardless.
# CODEKB_ALLOW_PRIVATE_GIT_ADDRESSES=true

# ─── Per-user git credentials ───
# Lets each user save a personal access token (on the Git credentials page) to
# analyze PRIVATE repositories. Public repos work without saved credentials.
#
# KMS key ARN that encrypts the tokens; setup_aws.sh prints it. Uncomment to use.
# CODEKB_GIT_CREDENTIALS_KMS_KEY_ARN=<YOUR_GIT_CREDENTIALS_KMS_KEY_ARN>

# Enabled providers — one, or a comma/space-separated list. Supported ids:
# github, gitlab, bitbucket. Defaults to github when unset. Set it to NONE to run
# with public repositories only. Any other value, including an empty one, stops
# CodeKB at startup with a message naming what to fix.
# CODEKB_GIT_CREDENTIALS_PROVIDERS=github

# Allow credentials embedded in a Git URL (https://user:token@host/repo.git).
# Defaults to false. Enable for deployments without a credentials KMS key that
# still need private repos. The token is persisted in the Space status.
# CODEKB_ALLOW_CREDENTIALS_IN_GIT_URL=true

# Your own git server, one per provider. Only needed for self-hosted repos;
# the public clouds always work without these.
# Give a full URL with http:// or https:// (a port is allowed), e.g.
# https://github.example.com or https://github.example.com:8443.
# CODEKB_GITHUB_CUSTOM_HOST=https://github.example.com
# CODEKB_GITLAB_CUSTOM_HOST=https://gitlab.example.com
# CODEKB_BITBUCKET_CUSTOM_HOST=https://bitbucket.example.com

# ─── Space authorization ───
# Gate space access by the caller's git permission. On by default: each signed-in
# caller can open only the spaces whose repo their saved git credential can access
# (public spaces stay open to any signed-in caller; uploaded zips are visible only
# to their creator). Pair with authentication on
# (CODEKB_REQUIRE_AUTHENTICATION=true, or its alias CODEKB_REQUIRE_AUTH=true) so
# each caller has a verified identity. With auth off the gate still runs, but
# identity is unverified and caller-controlled, so it is not a security boundary.
# Without a provider or credentials KMS key it still starts, serving public repos
# only (private repos are denied).
# Set to false to disable gating (any signed-in caller can access any space).
# CODEKB_REQUIRE_AUTHORIZATION=false

# How long a cached git permission is reused, in hours (how long a revoked grant
# can still work on one container). Defaults to 4.
# CODEKB_AUTHZ_REPO_CACHE_TTL_HOURS=4

# ─── Features ───
# Zip upload — whether users may create a space by uploading a zip. Defaults to true
# CODEKB_ZIP_UPLOAD_ENABLED=false

# Overview generation — whether users may generate a Space or Hyperspace Overview.
# Defaults to true. When false, generation requests are refused, the startup check
# skips the overview model, and overviews generated earlier stay readable.
# CODEKB_OVERVIEW_GENERATION_ENABLED=false

# ─── Analysis: extra exclude patterns ───
# Additional files/directories to skip during analysis, ON TOP OF the built-in
# defaults (.git, node_modules, __pycache__, build, dist, *.egg-info, ...). The
# built-ins are always kept, so you only list the extras you want.
#
# Patterns follow the gitignore standard (https://git-scm.com/docs/gitignore),
# so write them like .gitignore lines. Give a comma- or newline-separated list:
#   - No slash          -> matches a name at any depth ("vendor", "*.min.js")
#   - A slash           -> anchored to the repo root ("static/js/*.min.js")
#   - "**"              -> spans directories ("**/generated/**")
#   - Trailing "/"      -> directories only ("vendor/")
# Not supported: "!" negation and "[abc]" character classes.
#
# A space keeps the patterns it was created with, so a change here only
# affects spaces created afterwards.
#
# Tip: excluding bundled/minified assets such as "*.min.js" keeps large
# machine-generated files out of analysis.
# CODEKB_EXCLUDE_PATTERNS_EXTRA=*.min.js,vendor/,**/generated/**

# ─── Service runtime ───
# Summarization concurrency — parallel LLM calls per depth level (default: 40)
CODEKB_SUMMARIZATION_CONCURRENCY=40

# Space contexts (knowledge base, component catalog, call graph) kept in memory
# per process. Lower this if large spaces consume too much memory.
# CODEKB_MAX_CACHED_SPACES=50

# GiB used by extracted source trees under /tmp/codekb. Active analysis/refresh
# working trees are additional. 0 disables cache eviction.
# CODEKB_SOURCE_CACHE_MAX_SIZE_GB=10

# Hours a replica trusts cached source and KB data before checking S3 for a
# refresh completed by another replica. 0 disables this freshness check.
# CODEKB_SOURCE_CACHE_REFRESH_CHECK_TTL_HOURS=4

# Background jobs (analysis, refresh, overviews) allowed per process. Further job
# requests get HTTP 429 with Retry-After: 60. The deployment-wide maximum is this
# value times the process count. Size it from measured peak memory and disk use
# for one representative analysis. 0 disables the limit.
# CODEKB_PIPELINE_POOL_SIZE=32

# Seconds without progress before the next detailed status check marks an
# interrupted analysis or refresh failed.
# CODEKB_SUMMARIZATION_FAIL_AFTER_STALE_S=43200

# ─── AWS credentials (local/on-prem only) ───
# AWS_ACCESS_KEY_ID=<your-key>
# AWS_SECRET_ACCESS_KEY=<your-secret>
# AWS_SESSION_TOKEN=<your-token>
